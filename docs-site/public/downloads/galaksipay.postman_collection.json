        "body": {
          "mode": "raw",
          "raw": "{\n  \"UserName\": \"<server-secret-user>\",\n  \"Password\": \"<server-secret-password>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
